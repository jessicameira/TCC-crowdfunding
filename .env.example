# Ambiente
NODE_ENV=development

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / PostGIS
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tcc_eventos

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Autenticação
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1d

# Token Bucket (rate limiting)
TOKEN_BUCKET_CAPACITY=100
TOKEN_BUCKET_REFILL_RATE=20

# Frontend (Vite exige o prefixo VITE_ para expor a variável no client)
VITE_API_URL=http://localhost:3000
